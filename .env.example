# Скопируй в .env и заполни. НИКОГДА не коммить .env и не отправляй приватный ключ никому.

# Ключ ФАНДЕД dev-кошелька (тот, что дали под программу). Только локально!
DREAMDEX_PRIVATE_KEY=

# RPC Somnia (обязательно). mainnet chainId 5031 / testnet 50312 — определяется по REST URL ниже.
DREAMDEX_CHAIN_RPC=

# REST API. Пусто = mainnet (https://api.dreamdex.io/v0).
# Для ТЕСТНЕТА укажи: https://stg.api.dreamdex.io/v0
DREAMDEX_REST_URL=

# Не нужны: адреса токенов/контрактов берутся из /v0/markets; филлы — из on-chain события OrderFilled.
# (WS опционально, по умолчанию не используется)
DREAMDEX_WS_URL=

# 1 = симуляция (мок, без реальных ордеров). Убрать/0 для боевого/тестнет-запуска.
DRY_RUN=0

VPS
IP=
LOGIN=
PASS=
